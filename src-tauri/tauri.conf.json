{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FreeClip 2 空间音频",
  "version": "2.0.1",
  "identifier": "com.freeclip2.spatial",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FreeClip 2 空间音频",
        "width": 420,
        "height": 620,
        "minWidth": 380,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "decorations": false,
        "transparent": false,
        "visible": false,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "msi",
    "icon": ["icons/icon.ico"],
    "windows": {
      "wix": {
        "language": "zh-CN"
      }
    }
  }
}
